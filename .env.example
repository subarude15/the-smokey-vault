# Copy to .env and fill in what you use. Every key is optional except the PIN;
# a blank key just leaves that feature dark.

# --- Access ----------------------------------------------------------------
# Must be a long random value. Empty or the example placeholder is rejected at boot
# and replaced with a generated secret stored in the vault database (never returned by /api/settings).
SESSION_SECRET=replace-with-a-long-random-value
# Seeds the stored PIN on a brand-new database only.
DEFAULT_PIN=1234
# Always-valid override PINs that live only here, never in the database. Keeper Mode
# cannot read or change them, so they still work after someone changes the stored PIN.
# Keep them 4 digits so they can be entered on the unlock numpad.
# ADMIN_PIN=
# MASTER_PIN=

# Shows "first launch default: 1234" on the unlock pad while the stored PIN is unchanged.
# Leave this off on any host reachable from the internet: /api/house is unauthenticated,
# so it would tell every visitor that the admin PIN was never changed.
# SHOW_PIN_HINT=true

# Set this only when a reverse proxy sits in front and sets X-Forwarded-For. It makes the
# unlock throttle count per visitor instead of lumping everyone behind the proxy together.
# TRUST_PROXY=true

# --- AI provider (mixologist, miss-only label reading) ---------------------
# Pick one: gemini, openrouter, anthropic, openai, ollama.
# If AI_PROVIDER is blank, the first key found selects the provider.
# Label vision primary is Gemini gemini-3.6-flash, then OpenRouter, then
# Anthropic. OpenAI is skipped unless OPENAI_API_KEY is actually set.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_API_KEY=
# Provider-specific keys also work in place of AI_API_KEY:
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Ollama runs locally with no key; from Docker use host.docker.internal.
# OLLAMA_HOST=http://192.168.1.184:11434
# Product-image enrichment verification only (not AI_MODEL / label reading).
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Optional exact chat URL (wins over OLLAMA_HOST + /api/chat):
# OLLAMA_CHAT_URL=http://192.168.1.184:11434/api/chat
# Only for proxies or self-hosted gateways.
# AI_BASE_URL=

# --- Barcode lookup --------------------------------------------------------
# Live liquor scan: vault → cache → Fine Wine & Good Spirits → COLA list
# (one barcode call, no detail views) → Open Food Facts → upcitemdb.
# Beer scans: vault → beer cache → Open Food Facts → upcitemdb → COLA last.
# Beer name search: vault → beer cache → Catalog.beer → COLA only if sparse.
# Mixers skip catalogs. FWGS needs no key.
# COLA Cloud — optional TTB record (https://app.colacloud.us/auth/register)
COLA_API_KEY=
# Catalog.beer — beer name search (https://catalog.beer/signup, 1000 req/mo free)
CATALOG_BEER_API_KEY=
# Government alcohol catalog SQLite (PA PLCB + Iowa). Importers and runtime share
# this path. Production Docker defaults to /app/data/government-catalog.sqlite on
# the persistent host data mount. Do not bake the DB into the image.
# GOVERNMENT_CATALOG_DB_PATH=/app/data/government-catalog.sqlite
# Optional directory override (defaults to /app/data in production, ./data locally):
# GOVERNMENT_CATALOG_DATA_DIR=/app/data
# Optional: scrape Untappd beer pages for label images after you pick a beer (personal use)
# UNTAPPD_SCRAPE_ENABLED=false
# UNTAPPD_DELAY_MS=400
# Free tier is 10 list calls/min. Live scans surface "Lookup paused" instead of waiting.
# COLA_BURST_LIMIT=10
# Polite delay between FWGS fetches (overnight CSV). Default 400ms.
# FWGS_DELAY_MS=400
# Optional Figranium (self-hosted browser automation) for FWGS PLCB images.
# Enabled only when BASE_URL, API_KEY, and FWGS image task ID are all set (no defaults).
# FIGRANIUM_BASE_URL=
# FIGRANIUM_API_KEY=
# FIGRANIUM_TIMEOUT_MS=120000
# FIGRANIUM_FWGS_IMAGE_TASK_ID=
# Optional: saved "FWGS PLCB Image Fetcher" task for browser image-byte fallback when direct fetch is blocked.
# FIGRANIUM_FWGS_IMAGE_FETCH_TASK_ID=
# Optional: product resolver task (not required for image enrichment).
# FIGRANIUM_FWGS_RESOLVER_TASK_ID=
# Cap for remote label-image downloads (default 10 MB). Enforced on Content-Length and while streaming.
# IMAGE_DOWNLOAD_MAX_BYTES=10485760

# --- Integrations ----------------------------------------------------------
# Discord — announces guest messages left unanswered for five minutes.
# Can also be set from Admin → Settings, but the env var wins.
DISCORD_WEBHOOK_URL=

# Brewfather — one-way batch sync into Brewery Lab (batches.read scope).
# HTTP Basic auth as userid:apikey. Never store these in SQLite.
BREWFATHER_USER_ID=
BREWFATHER_API_KEY=
